{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.data-agent/schemas/release-manifest.schema.json",
  "title": "Knowledge release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_schema_version", "release_id", "knowledge_version", "status", "created_at", "contracts", "golden_suites", "required_gates", "approval", "rollback"],
  "properties": {
    "manifest_schema_version": {"const": "1.0.0"},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "knowledge_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "status": {"enum": ["candidate", "released", "superseded", "rolled_back"]},
    "created_at": {"type": "string", "format": "date-time"},
    "released_at": {"type": ["string", "null"], "format": "date-time"},
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "sources"],
      "properties": {
        "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
      }
    },
    "golden_suites": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "required_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "approved_by", "approved_at"],
      "properties": {
        "state": {"enum": ["pending", "approved", "rejected"]},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_release_id"],
      "properties": {
        "previous_release_id": {"type": ["string", "null"]}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "files"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "files": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "released"}}, "required": ["status"]},
      "then": {"required": ["integrity"]}
    }
  ],
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    }
  }
}
