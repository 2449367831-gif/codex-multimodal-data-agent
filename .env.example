# Doris is the only business-data source. Use a dedicated read-only account.
DORIS_HOST=127.0.0.1
DORIS_PORT=9030
DORIS_USER=readonly_user
DORIS_PASSWORD=
DORIS_DATABASE=ywzt_ods
DORIS_EXECUTION_MODE=mock

# Keep false in production. This exists only for controlled pre-release smoke tests.
AGENT_ALLOW_UNAPPROVED_CONTRACTS=false
AGENT_QUERY_TIMEOUT_SECONDS=60
AGENT_MAX_ROWS=10000
AGENT_MAX_SQL_LENGTH=100000
AGENT_MAX_RESPONSE_BYTES=6000000
# Add only business schemas backed by a read-only Doris grant. The semantic
# source contracts in sources/tables remain the runtime authority.
AGENT_SQL_ALLOWED_SCHEMAS=ywzt_ods,dms_ods,information_schema
AGENT_SQL_ALLOWED_CATALOGS=internal
AGENT_BUSINESS_TIMEZONE=Asia/Shanghai

# Runtime repository and audit. The audit stores metadata only, never Doris business rows.
AGENT_PROJECT_ROOT=D:/取数agent
AGENT_RELEASE_ID=
# Required in Doris mode for a released manifest. Keep this digest in deployment secrets.
AGENT_TRUSTED_RELEASE_SHA256=
AGENT_AUDIT_DB=./var/audit.sqlite3

# Service settings
AGENT_HOST=127.0.0.1
AGENT_PORT=8010
AGENT_LOG_LEVEL=INFO
AGENT_QUERY_BACKEND_URL=http://127.0.0.1:8010

# Department-local identity: generated once per installed machine, without login.
AGENT_CHAT_IDENTITY_MODE=installation
AGENT_INSTALLATION_ID_PATH=./var/installation-identity.json
# Only required if a future deployment explicitly switches back to wecom_signed.
AGENT_CHAT_IDENTITY_SECRET=
AGENT_CHAT_PRINCIPAL_PEPPER=
AGENT_CHAT_SESSION_DB_PATH=./var/chat-sessions.sqlite3
# Optional separate protected SQLite file for the private test-learning ledger.
# Empty means reuse the session database directory without mixing table names.
AGENT_LEARNING_DB_PATH=
AGENT_CHAT_SECURE_COOKIES=false
# Frontend aliases are local only; one installation owns one backend conversation.
AGENT_CHAT_MAX_CONVERSATIONS=1

# Project-local Codex model provider. Store the key with
# scripts/configure_model_provider.ps1; never put it in this file.
AGENT_CODEX_HOME=./var/codex-home
AGENT_CODEX_BASE_URL=http://192.168.110.9:8088
AGENT_CODEX_MODEL_PROVIDER=agent_gateway
AGENT_CODEX_MODEL=gpt-6
AGENT_CODEX_REASONING_EFFORT=low
AGENT_CODEX_FALLBACK_MODEL=gpt-5.6-terra
AGENT_CHAT_TASK_TIMEOUT_SECONDS=480
AGENT_MODEL_TURN_TIMEOUT_SECONDS=180
AGENT_MODEL_RETRY_TIMEOUT_SECONDS=90
