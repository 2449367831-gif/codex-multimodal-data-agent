{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.data-agent/schemas/golden-question-suite.schema.json",
  "title": "Metric routing golden-question suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_schema_version", "suite_id", "version", "status", "cases"],
  "properties": {
    "suite_schema_version": {"const": "1.0.0"},
    "suite_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "status": {"enum": ["candidate", "active", "deprecated"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "test_level", "question", "context", "expected", "tags", "rationale"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "test_level": {"enum": ["router_smoke", "contract_only", "end_to_end"]},
        "question": {"type": "string", "minLength": 2},
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "now": {"type": "string", "format": "date-time"},
            "previous_request": {"type": ["object", "null"]},
            "explicit_profile_id": {"type": ["string", "null"]}
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "must_not_inherit"],
          "properties": {
            "action": {"enum": ["route", "clarify", "reject"]},
            "metric_id": {"type": "string"},
            "metric_version": {"type": "string"},
            "candidate_metric_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "unavailable_variants": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "clarification_key": {"type": "string"},
            "reason_code": {"type": "string"},
            "profile_id": {"type": ["string", "null"]},
            "parameters": {"type": "object"},
            "must_not_inherit": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "forbidden_metric_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          },
          "allOf": [
            {
              "if": {"properties": {"action": {"const": "route"}}},
              "then": {"required": ["metric_id", "metric_version"]}
            },
            {
              "if": {"properties": {"action": {"const": "clarify"}}},
              "then": {"required": ["clarification_key"]}
            },
            {
              "if": {"properties": {"action": {"const": "reject"}}},
              "then": {"required": ["reason_code"]}
            }
          ]
        },
        "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "rationale": {"type": "string", "minLength": 5}
      }
    }
  }
}
